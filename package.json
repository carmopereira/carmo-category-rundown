{
	"name": "carmo-category-rundown",
	"version": "0.1.6",
	"description": "WordPress block: WooCommerce product category carousel with image cards, configurable columns for desktop and mobile.",
	"author": "João Carmo Pereira",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"prebuild": "npm version patch --no-git-tag-version && node scripts/sync-version.js",
		"updateGIT": "node scripts/update-git.js",
		"symlink": "node scripts/create-symlink.js",
		"make-pot": "wp i18n make-pot . languages/carmo-category-rundown.pot --exclude=node_modules,src,scripts --slug=carmo-category-rundown"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/i18n": "latest"
	},
	"devDependencies": {
		"@wordpress/scripts": "^33.0.0"
	},
	"main": "build/index.js"
}
